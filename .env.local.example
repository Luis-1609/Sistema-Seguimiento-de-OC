# Variables de entorno para Google Sheets OAuth2
# Copia este archivo como .env.local y rellena los valores

# ID de cliente OAuth2 de Google Cloud Console
GOOGLE_CLIENT_ID=tu_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui

# Refresh token obtenido mediante el flujo OAuth2 offline
GOOGLE_REFRESH_TOKEN=tu_refresh_token_aqui

# ID del Google Sheet (la parte de la URL entre /d/ y /edit)
GOOGLE_SHEET_ID=tu_sheet_id_aqui

# Nombre de la hoja (pestaña) donde están los datos
GOOGLE_SHEET_NAME=Ordenes
